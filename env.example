# OpenAI
OPENAI_API_KEY=sk-...

# Suno API — adres Twojego wrappera suno-api
# Opcja 1: self-hosted na Railway: https://github.com/gcui-art/suno-api
# Opcja 2: usługa zewnętrzna np. https://www.sunoapi.pro
SUNO_API_URL=https://twoj-suno-wrapper.railway.app
SUNO_API_KEY=...

# Stripe
STRIPE_PUBLISHABLE_KEY=pk_live_...
