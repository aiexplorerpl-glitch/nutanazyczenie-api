STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PIOSENKA=price_...
STRIPE_PRICE_WIDEO=price_...
STRIPE_PRICE_PREMIUM=price_...

# Resend
RESEND_API_KEY=re_...

# Supabase
