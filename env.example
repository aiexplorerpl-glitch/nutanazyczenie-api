# OpenAI — platform.openai.com → API Keys
OPENAI_API_KEY=sk-...

# Suno — suno.com → Account → API Key
SUNO_API_KEY=...

# Stripe — dashboard.stripe.com → Developers → API Keys
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe — Price IDs (dashboard.stripe.com → Products)
STRIPE_PRICE_PIOSENKA=price_...
STRIPE_PRICE_WIDEO=price_...
STRIPE_PRICE_PREMIUM=price_...

# Resend — resend.com → API Keys
RESEND_API_KEY=re_...

# Supabase — supabase.com → Settings → API
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_KEY=sb_secret_...

# Aplikacja
BASE_URL=https://nutanazyczenie.pl
FROM_EMAIL=kontakt@nutanazyczenie.pl
PORT=8000
